# Telegram
TELEGRAM_BOT_TOKEN=replace_in_render
TELEGRAM_GROUP_ID=-1001234567890
WEBHOOK_SECRET=replace_with_32_or_more_letters_and_numbers

# Usedesk
USEDESK_API_TOKEN=replace_in_render
USEDESK_COMPANY_ID=123456
USEDESK_CHAT_CHANNEL_ID=1234
USEDESK_APP_ID=1234
USEDESK_API_BASE_URL=https://api.usedesk.ru

# Render supplies RENDER_EXTERNAL_URL automatically. Set PUBLIC_BASE_URL locally only.
PUBLIC_BASE_URL=https://your-service.onrender.com
PORT=3000

# Optional locally. Render wires this automatically from Managed PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
REPLY_TO_LAST_TELEGRAM_MESSAGE=false
MEDIA_LINK_TTL_SECONDS=604800
